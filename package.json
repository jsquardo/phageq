  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.0.0",
    "bullmq": "^4.0.0",
    "jest": "^29.7.0",
    "p-queue": "^7.4.1",
    "picomatch": "^2.3.2",
    "toad-scheduler": "^2.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "picomatch": "^2.3.2",
    "brace-expansion": "^5.0.5",
    "minimatch": "^10.0.3",
    "glob": "^10.5.1",
    "handlebars": "^4.7.9"
