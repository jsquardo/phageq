    "jest": "^29.7.0",
    "p-queue": "^8.0.1",
    "redis": "^4.7.0",
    "toad-scheduler": "^3.0.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "picomatch": "^2.3.2",
    "brace-expansion": "^2.0.1"
