{
  "name": "phageq",
  "version": "0.1.0",
  "description": "A high-performance TypeScript task queue library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
